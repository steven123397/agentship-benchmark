{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness-manifest.schema.json",
  "title": "DecisionHarbor v0.2.0 hidden harness freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "artifact", "entrypoint", "environment", "coverage", "candidateAccess", "frozenAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": {"const": "baseline-v0.2.0"},
        "commit": {"const": "9355032ecadd6d3c940d7977fe381f9f8a93b1ab"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "entrypoint": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidateAccess": {"const": false},
    "frozenAt": {"type": "string", "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
