{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills.schema.json",
  "title": "DecisionHarbor v0.2.0 candidate skill usage evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "sharedExternalSkillsManifest", "usedGlobalSkills", "harnessBuiltInSkills", "notes", "scoringTreatment"],
  "properties": {
    "schemaVersion": {"const": 2},
    "source": {"type": "string", "minLength": 1},
    "sharedExternalSkillsManifest": {"const": "../../shared-external-skills.json"},
    "usedGlobalSkills": {"$ref": "#/definitions/usageList"},
    "harnessBuiltInSkills": {"$ref": "#/definitions/usageList"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "scoringTreatment": {"const": "names_and_counts_not_scored; observable_workflow_evidence_is_scored_via_workflow.json"}
  },
  "definitions": {
    "usageList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "evidenceRefs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
